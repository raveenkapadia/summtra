run = "npx serve -s . -l 3000"
entrypoint = "index.html"
modules = ["web", "nodejs-20", "nix", "python-3.11"]

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "npx serve -s . -l 3000"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Summtra Web Server"

[[workflows.workflow]]
name = "Summtra Web Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx serve -s . -l 5000"
waitForPort = 5000
